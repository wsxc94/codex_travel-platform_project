# Tabimaru 로컬 실행용 예시. `copy .env.example .env` 후 필요한 값만 채운다. 모두 선택 사항이다.
# 비워 둔 값은 설정하지 않은 것으로 본다. 셸에 이미 있는 환경변수가 .env보다 우선한다.
PORT=

# ── 장소·지도 공급자 ──
# free(기본): 내장 큐레이션 + 위키미디어 사진·좌표. Google 호출 0회, 요금 없음.
# google: Places API(New)·Geocoding·Directions 사용(결제 계정·서버 키 필요). 실패하면 free 데이터로 대신한다.
PLACES_PROVIDER=
# osm(기본): OpenStreetMap + Leaflet. google: Maps JavaScript API(GOOGLE_MAPS_BROWSER_KEY 필요, 없으면 osm).
MAP_PROVIDER=
# 서버 전용 키(브라우저로 보내지 않음). API 제한: Places API (New), Geocoding API, Directions API.
GOOGLE_MAPS_SERVER_KEY=
# 브라우저용 키(/api/maps-config로 공개됨). HTTP 리퍼러 제한 + API 제한: Maps JavaScript API만.
GOOGLE_MAPS_BROWSER_KEY=
# 예전 단일 키. google 모드에서 서버 키가 없을 때만 서버 키로 쓴다(브라우저로는 보내지 않음). 새로 설정하지 말 것.
GOOGLE_MAPS_API_KEY=
# google 모드의 Google 호출 상한(UTC 날짜·UTC 월 기준). 넘으면 다음 날/다음 달까지 free 데이터로 응답한다.
# 카운터는 서버 메모리에 있어 재시작하면 0부터 다시 센다 → 비용을 확실히 막는 것은 Google Cloud 콘솔의 할당량 상한이다.
# 검색·지오코딩·경로(Places Text Search, Geocoding, Directions) 하루 상한. 기본 30.
GOOGLE_DAILY_CALL_LIMIT=
# 검색·지오코딩·경로 월 상한. 기본 900(Text Search Enterprise SKU의 월 무료 사용량 1,000건보다 낮게).
GOOGLE_MONTHLY_CALL_LIMIT=
# 사진(Place Photos) 하루 상한. 기본 30. 사진은 검색 예산과 따로 센다.
GOOGLE_PHOTO_DAILY_LIMIT=
# 사진 월 상한. 기본 900(Place Details Photos SKU의 월 무료 사용량 1,000건보다 낮게).
GOOGLE_PHOTO_MONTHLY_LIMIT=
# /api/ai-diagnostics?probe=1 (실제 외부 호출) 에 필요한 토큰. 헤더 x-diagnostics-token 으로 보낸다. 비우면 probe 비활성.
DIAGNOSTICS_TOKEN=

# ── AI 일정·채팅 (하나 이상 권장, 없으면 규칙 기반) ──
GEMINI_API_KEY=
# 1순위 모델. 비우면 gemini-2.5-flash(운영은 gemini-2.5-flash-lite 권장)
GEMINI_API_MODEL=
# 1순위 모델이 한도(429)·과부하(503)·종료(404)·시간 초과일 때 차례로 쓸 대체 모델(쉼표 구분). 'none'이면 1순위 모델만.
# 비우면 실측 순서: gemini-2.5-flash-lite, gemini-3.1-flash-lite, gemini-3-flash-preview, gemini-3.5-flash-lite, gemini-2.5-flash, gemini-3.6-flash, gemini-flash-latest
# (1순위 모델과 같은 이름은 빠짐). 무료 한도는 모델마다 하루 20회라 모델이 많을수록 하루에 더 쓸 수 있다.
GEMINI_FALLBACK_MODELS=
# 한 번 생성(채팅 해석·일정 하나)에 모델 체인 전체가 쓸 수 있는 시간(ms, 기본 40000, 최소 4000). 넘으면 다음 모델을 시도하지 않고 규칙 기반으로.
GEMINI_TOTAL_BUDGET_MS=
# OpenAI 호환 공급자(OpenAI 또는 Groq). 비우면 https://api.openai.com/v1 (OPENAI_API_KEY 없이 GROQ_API_KEY만 있으면 Groq 주소)
# Groq 무료(카드 불필요): GROQ_API_KEY=gsk_..., OPENAI_BASE_URL=https://api.groq.com/openai/v1, OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=
# OpenAI 키(sk-). Groq 주소가 아닐 때만 보낸다. Groq 키(gsk_)는 여기에 넣지 말고 GROQ_API_KEY에.
OPENAI_API_KEY=
# Groq 키(gsk_). OPENAI_BASE_URL이 Groq 주소일 때만 보낸다.
GROQ_API_KEY=
# 비우면 gpt-4o-mini(Groq는 openai/gpt-oss-120b)
OPENAI_MODEL=
# 주 모델이 한도(429)·요청 큼(413)·모델 없음(404)·5xx·시간 초과·잘림·형식 오류일 때 차례로 쓸 대체 모델(쉼표 구분, 최대 4개). 비우면 주 모델만.
# Groq 예: openai/gpt-oss-20b,qwen/qwen3.8-27b (qwen은 미리보기라 맨 뒤)
OPENAI_FALLBACK_MODELS=
# 출력 토큰 상한(0·비우면 상한 없음, 최소 256). Groq 무료는 분당 8천 토큰이라 3500 권장.
OPENAI_MAX_OUTPUT_TOKENS=
# 추론 모델의 생각 정도(none·default·minimal·low·medium·high). 비우면 보내지 않음(gpt-4o-mini는 이 값을 거절). Groq는 low 권장.
OPENAI_REASONING_EFFORT=
# 채팅 해석에서 AI 공급자를 시도하는 순서(gemini·openai, 쉼표 구분). 비우면 gemini,openai. 일정 생성은 늘 Gemini → OpenAI 호환 순서.
AI_CHAT_PROVIDER_ORDER=
AI_REQUEST_TIMEOUT_MS=
CHAT_PARSE_STRICT_AI=

# ── 항공권 (Travelpayouts, 없으면 예시 데이터) ──
TRAVELPAYOUTS_TOKEN=

# ── 숙소 (Rakuten Travel, 없으면 예시 데이터) ──
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# ── 맛집 (ホットペッパー グルメサーチAPI, 무료·메일로 신청: webservice.recruit.co.jp) ──
# 있으면 무료 모드 맛집 검색·추천 맛집이 도시 중심 3km 안 실제 가게(최대 30곳)가 된다. 없으면 내장 맛집 목록.
HOTPEPPER_API_KEY=

# ── 환율 고정값 (실시간 조회 open.er-api → frankfurter 가 모두 실패할 때만) ──
FX_USD_KRW=
FX_JPY_KRW=

# ── 로그인·세션·보안 ──
# 로그인 쿠키(sid, 30일) 서명값. 32자 이상 + 서로 다른 글자 10개 이상인 무작위 값만 쓴다(더 약하면 버리고 경고).
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 비우거나 약하면 실행마다 임의 값을 만들어 재시작 시 로그인이 풀린다.
# 바꾸면 모든 기기의 로그인이 풀리지만 저장한 일정은 그대로다(사용자 id는 이 값과 관계없음).
SESSION_SECRET=
# 로그인할 수 있는 계정(쉼표 구분, 비우면 누구나): u_…(로그인 후 /api/auth/me 의 userId), google:<id>·kakao:<id>·naver:<id>,
# 또는 공급자가 확인한 이메일(Google·Kakao만). 목록을 바꾸면 모든 기기가 한 번 로그아웃된다. 혼자 쓰면 설정 권장.
ALLOWED_LOGINS=
# 공개 주소(예: https://japanjapantravel.onrender.com). CSRF 허용 출처에 쓴다.
PUBLIC_BASE_URL=
# OAuth 콜백 기준 주소. 비우면 http://localhost:<PORT>
OAUTH_BASE_URL=
# 1이면 X-Forwarded-For의 마지막 값(프록시가 붙인 값)을 클라이언트 IP로 쓴다. Render에서는 자동으로 켜진다.
# 그 값이 Cloudflare 공개 IP 대역이면 한 칸 앞 값을 쓴다.
TRUST_PROXY=
# 프록시가 여러 단일 때 뒤에서 N번째 값을 쓴다(기본 1). 배포 로그의 "[proxy] 처음 50개 요청의 … 분포" 줄을 보고 정한다.
TRUST_PROXY_HOPS=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# ── 일정 저장소 (Supabase, 선택 — 서버 전용 키) ──
# 설정하면 "내 일정"이 Supabase travel_plans 표에 저장된다(재시작·재배포에도 남음). 비우면 아래 데이터 폴더의 파일에 저장.
# 프로젝트 주소(https://<프로젝트>.supabase.co)
SUPABASE_URL=
# 서버 전용 키: 새 형식 secret 키(sb_secret_…) 또는 예전 service_role 키(eyJ…). 브라우저용 publishable/anon 키는 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 로컬 데이터 폴더 (선택) ──
# users.json·saved_plans.json(Supabase가 없을 때의 내 일정)을 둘 절대 경로. 비우면 <저장소>/data.
# TABIMARU_DATA_DIR=

# ── 테스트 전용(운영에서는 비워 둔다): 외부 API 주소를 가짜 서버로 바꿀 때만 쓴다 ──
# PLACES_API_BASE=
# GEOCODE_API_BASE=
# GEMINI_API_BASE=
# TRAVELPAYOUTS_API_BASE=
# RAKUTEN_API_BASE=
# PLACE_IMAGES_FILE=
